# Configure these in Sites runtime settings. Real values belong in ignored .dev.vars locally.
WORKSPACE_OWNER_EMAIL="owner@example.com"
WORKSPACE_INVITE_EMAILS='["colleague@example.com"]'
# Enable only after the owner approves a public sign-in entry point with server-side membership enforcement.
APP_MANAGED_INVITES="disabled"
# Gmail invitation sender: deploy integrations/google-mail/Code.gs as the owner.
# Keep the generated secret in Sites runtime secrets. Never use real mail credentials in tests.
INVITE_MAIL_URL=""
INVITE_MAIL_SECRET=""
